# Copy to .env.local and fill in. .env.local is gitignored - never commit real values.
#
# Fastest way to get all of these at once, if you have Vercel access:
#   npx vercel link
#   npx vercel env pull .env.local
#
# ─── Database (Prisma) ───────────────────────────────────────────────────────
# DIRECT_URL is the non-pooled connection, used for migrations / db push.
DATABASE_URL=
DIRECT_URL=

# ─── Auth (NextAuth + LinkedIn OIDC) ─────────────────────────────────────────
# NEXTAUTH_URL MUST match the port the dev server actually runs on. `npm run dev`
# is pinned to 3002 in package.json, so locally this is localhost:3002 - leaving
# it unset makes NextAuth fall back to localhost:3000 and the OAuth round trip
# lands on a dead port.
#
# The same URL + /api/auth/callback/linkedin must also be registered under
# "Authorized redirect URLs" in the LinkedIn developer app, or sign-in fails
# with error=OAuthSignin no matter what is set here.
NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ─── AI ──────────────────────────────────────────────────────────────────────
# Text generation (gemini-2.5-flash) and the photographic image formats
# (gemini-3.1-flash-image). The designed formats are rendered in code and need
# no key - see lib/render-card.tsx.
GOOGLE_AI_API_KEY=

# ─── Storage (Vercel Blob) ───────────────────────────────────────────────────
# Read by @vercel/blob automatically. Without it, image generation and uploads
# fail at the put() call.
BLOB_READ_WRITE_TOKEN=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=

# ─── Billing (Razorpay) ──────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID_INR=
RAZORPAY_PLAN_ID_USD=
RAZORPAY_WEBHOOK_SECRET=

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# Protects the Vercel Cron routes. Leave empty locally.
CRON_SECRET=
# Locks an entire non-production deployment behind the browser's own HTTP Basic
# prompt. BOTH must be set for the lock to exist - either one empty and it is a
# no-op, which is how local development stays open. Leave both empty locally.
#
# Read these before setting them on an environment. The lock applies to every
# host that serves that environment EXCEPT kruti.io and www.kruti.io, which
# lib/staging-gate.ts exempts by name. That exemption is by HOSTNAME, and it
# therefore does not cover Vercel Cron: the platform calls the deployment's own
# *.vercel.app host, not the custom domain, so a locked environment turns every
# cron away at the middleware - on production too. The crons are exempted by
# PATH instead; see isExempt() in that file.
#
# SITE_PASSWORD used to live here, for an in-app password page that no longer
# exists. Nothing read it any more, so it has been removed rather than left to
# look like the gate it is not.
STAGING_GATE_USER=
STAGING_GATE_PASSWORD=
# USD -> INR rate used by the admin cost estimates. Defaults to 85.
USD_TO_INR=

# ─── Images ──────────────────────────────────────────────────────────────────
# Which model draws the pictures. Empty or unrecognised = gemini.
#   gemini (gemini-3.1-flash-image) · gemini-2.1 · gemini-lite
#   recraft-v3 · recraft-v4.1-flash
IMAGE_PROVIDER=
# Resolution for every generated image, single and carousel alike.
# Empty or unrecognised = 2K. Gemini tier per image: 1K $0.067 · 2K $0.101 · 4K $0.15.
# 4K is slower, and carousel slides generate in parallel under maxDuration = 60.
IMAGE_SIZE=
