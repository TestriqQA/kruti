# Copy to .env.local and fill in. .env.local is gitignored - never commit real values.
#
# Fastest way to get all of these at once, if you have Vercel access:
#   npx vercel link
#   npx vercel env pull .env.local
#
# ─── Database (Prisma) ───────────────────────────────────────────────────────
# DIRECT_URL is the non-pooled connection, used for migrations / db push.
DATABASE_URL=
DIRECT_URL=

# ─── Auth (NextAuth + LinkedIn OIDC) ─────────────────────────────────────────
# NEXTAUTH_URL MUST match the port the dev server actually runs on. `npm run dev`
# is pinned to 3002 in package.json, so locally this is localhost:3002 - leaving
# it unset makes NextAuth fall back to localhost:3000 and the OAuth round trip
# lands on a dead port.
#
# The same URL + /api/auth/callback/linkedin must also be registered under
# "Authorized redirect URLs" in the LinkedIn developer app, or sign-in fails
# with error=OAuthSignin no matter what is set here.
NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ─── AI ──────────────────────────────────────────────────────────────────────
# Text generation (gemini-2.5-flash) and the photographic image formats
# (gemini-3.1-flash-image). The designed formats are rendered in code and need
# no key - see lib/render-card.tsx.
GOOGLE_AI_API_KEY=

# ─── Storage (Vercel Blob) ───────────────────────────────────────────────────
# Read by @vercel/blob automatically. Without it, image generation and uploads
# fail at the put() call.
BLOB_READ_WRITE_TOKEN=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=

# ─── Billing (Razorpay) ──────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID_INR=
RAZORPAY_PLAN_ID_USD=
RAZORPAY_WEBHOOK_SECRET=

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# Protects the Vercel Cron routes. Leave empty locally.
CRON_SECRET=
# Set to enable the site-wide password gate. Leave empty locally.
SITE_PASSWORD=
# USD -> INR rate used by the admin cost estimates. Defaults to 85.
USD_TO_INR=
