generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Non-pooled connection for migrations
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                  String        @id @default(cuid())
  linkedinId          String?       @unique
  name                String?
  email               String?       @unique
  emailVerified       DateTime?
  role                String        @default("user")  // "user" | "admin"
  image               String?
  headline            String?
  summary             String?       @db.Text
  skills              String?       @db.Text // JSON array string
  industry            String?
  profileUrl          String?
  tonePrefs           String?       @db.Text // JSON: formal/casual/inspirational
  // Onboarding & content preferences
  onboardingCompleted Boolean       @default(false)
  contentGoals        String?       @db.Text // JSON: ["Lead Generation", "Brand Awareness"]
  positioning         String?       // "Thought Leader" | "Industry Expert" | etc.
  contentStyles       String?       @db.Text // JSON: ["Narrative", "How-to", ...]
  targetAudience      String?       @db.Text // free text description
  humanMode           Boolean       @default(false)
  postingSchedule     String?       @db.Text // JSON: { days: ["Monday","Wednesday"], time: "09:00" }
  postSignature       String?       @db.Text // Text always appended to every LinkedIn post
  timezone            String        @default("Asia/Kolkata") // IANA timezone string
  accounts            Account[]
  sessions            Session[]
  contentPlans        ContentPlan[]
  newsletters         Newsletter[]
  subscription        Subscription?
  supportTickets      SupportTicket[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Subscription {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  razorpayCustomerId      String?   @unique
  razorpaySubscriptionId  String?   @unique
  razorpayPlanId          String?
  currency                String    @default("INR") // "INR" or "USD"
  status                  String    @default("trialing") // trialing|active|past_due|canceled|unpaid
  trialEnd                DateTime?
  currentPeriodEnd        DateTime?
  postsGeneratedThisCycle Int       @default(0)   // hard count of posts generated in current billing cycle
  cyclePostsResetAt       DateTime? // when the post counter was last reset (start of cycle)
  trialRemindersSent      String    @default("")  // comma-separated: "3d,1d,0d"
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model ContentPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime // Monday of the week this plan covers
  strategy  String   @db.Text // JSON: pillars, theme, audience, tone, postMix
  posts     Post[]
  createdAt DateTime @default(now())

  @@unique([userId, weekStart])
}

model Post {
  id                String      @id @default(cuid())
  planId            String
  plan              ContentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title             String      @db.Text
  body              String      @db.Text
  imageUrl          String?
  imagePrompt       String?     @db.Text
  imageGenCount     Int         @default(0) // number of times image was generated for this post
  carouselImages    String?     @db.Text // JSON array of image URLs for a multi-image carousel post
  imageHistory      String?     @db.Text // JSON string[][] - every generated/uploaded image set, so past results stay reusable
  documentUrl       String?     // uploaded PDF (published as a LinkedIn document / PDF carousel)
  documentName      String?     // original PDF filename, for display
  hashtags          String?     @db.Text // JSON array string
  postType          String      // thought-leadership | tips | story | poll | carousel
  style             String?     // the user-selected content style this post was written in (e.g. "Contrarian Take"); null for legacy posts -> badge falls back to postType
  imageStyle        String?     // chosen IMAGE CATEGORY id from lib/image-categories.ts; null (legacy) -> single-image render resolves to "infographic"
  scheduledAt       DateTime?
  status            String      @default("draft") // draft | ready | published
  weekNumber        Int         @default(1)
  humanModeOverride Boolean?    // null = use user default, true = on, false = off
  customSignature   String?     @db.Text // Overrides user.postSignature if not null. If empty string, means removed.
  postedToLinkedIn  Boolean     @default(false)
  linkedinPostId    String?     // UGC post ID from LinkedIn API
  postError         String?     @db.Text // last error if auto-post failed
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Engagement metrics (future: populated via LinkedIn API with r_member_social scope)
  linkedinLikes       Int?
  linkedinComments    Int?
  linkedinShares      Int?
  linkedinImpressions Int?
  engagementSyncedAt  DateTime?

  @@index([planId])
  @@index([status])
  @@index([scheduledAt])
}

model Newsletter {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  subject     String
  body        String   @db.Text // JSON: sections array
  pillars     String?  @db.Text // JSON: source pillars used
  scheduledAt DateTime?
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([scheduledAt])
}

// Global key-value settings for platform-wide admin toggles (not per-user).
// e.g. "imagePromptsRevealUntil" = ISO timestamp until which user image prompts
// are temporarily shown in admin analytics (privacy-gated, auto-expires).
model AppSetting {
  key       String   @id
  value     String?  @db.Text
  updatedAt DateTime @updatedAt
}

/// A support request raised by a user from /support. Deliberately flat: one
/// description, a few screenshots, one status. No threading, no replies.
model SupportTicket {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String   @db.Text
  /// JSON array of { url, name, size } for the uploaded screenshots.
  /// Blobs live under the "support/" prefix, which the image-cleanup cron
  /// deliberately never sweeps (see lib/image-cleanup.ts).
  screenshots String?  @db.Text
  status      String   @default("open") // open | in_progress | closed
  adminNote   String?  @db.Text
  replies     SupportReply[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

/// An admin's reply on a ticket.
///
/// Deliberately short-lived: a reply is deleted 3 days after it is written,
/// whether or not the user read it (runSupportCleanup in lib/scheduler.ts, wired
/// to a daily cron). Queries also filter by age so an expired reply disappears
/// the moment it is 3 days old, without waiting for the sweep.
model SupportReply {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message   String        @db.Text
  /// Who wrote it: "admin" | "user". Defaults to "admin" on purpose - every row
  /// that existed before the conversation became two-way was an admin reply, so
  /// the default backfills them correctly without a data migration.
  authorRole String       @default("admin")
  /// When the OTHER party read it. An admin reply is read by the user; a user
  /// reply is read by an admin. Only drives the unread badges - it never affects
  /// when the reply is deleted.
  readAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([ticketId])
  @@index([createdAt])
}
